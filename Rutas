                <!-- Telemetría Dinámica GPS -->
                <div id="info-posicion-envivo" class="px-5 py-3 bg-slate-900 text-white text-xs space-y-1">
                    <div class="flex justify-between items-center font-bold">
                        <span class="text-slate-300"><i class="fa-solid fa-satellite text-emerald-400"></i> Telemetría:</span>
                        <span id="txt-ultima-act" class="text-emerald-400 font-mono">En vivo</span>
                    </div>
                    <div class="font-mono text-[11px] text-slate-400" id="txt-coords-envivo">Esperando reporte GPS...</div>
                </div>

                <div class="flex-1 overflow-y-auto p-4 space-y-3 bg-slate-50" id="lista-paradas"></div>
            </aside>

            <!-- Mapa Principal Leaflet -->
            <main class="flex-1 relative flex flex-col">
                <div class="absolute top-4 right-4 z-[400] bg-slate-900/90 backdrop-blur-md text-white px-5 py-3 rounded-2xl shadow-2xl border border-slate-700 flex items-center gap-6">
                    <div class="text-center">
                        <span class="block text-[10px] uppercase tracking-wider text-slate-400 font-bold">Velocidad</span>
                        <span id="waze-speed" class="text-2xl font-black text-emerald-400">0.0</span>
                        <span class="text-xs text-slate-300">km/h</span>
                    </div>
                    <div class="h-8 w-px bg-slate-700"></div>
                    <div class="text-center">
                        <span class="block text-[10px] uppercase tracking-wider text-slate-400 font-bold">Próximo Destino</span>
                        <span id="waze-distance" class="text-xl font-bold text-emerald-400">0</span>
                        <span class="text-xs text-slate-300">m</span>
                    </div>
                    <div class="h-8 w-px bg-slate-700"></div>
                    <button id="btn-gps-toggle" onclick="activarGPSReal()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3.5 py-2 rounded-xl text-xs font-semibold shadow transition flex items-center gap-2">
